+        delivery: ZkTransfer,
+        payment: ZkTransfer,
+        expiry_height: u64,
+        intents: [DvpIntent; 2],
+        kind: DvpKind,
+        award: Option<SignedAward>,
+    ) -> Self {
+        Self { trade_id, delivery, payment, expiry_height, intents, kind, award }
+    }
+}
