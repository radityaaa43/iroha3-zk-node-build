+    }
+
+    const KEYS: &str = r#"[{"version":1,"pk":"00","activation_height":1,"retire_height":null}]"#;
+
+    /// Block 2 on a world with domain `rd` owned by `bi`; `rd` and `dfabi` are zk assets with
+    /// `rd_disclosure = "required"` (auditor `bi`, key version 1 active), `plain` is a zk asset without it.
+    /// The setup transaction is applied; tests open their own transactions on the block.
+    fn world(f: impl FnOnce(&mut StateBlock<'_>, &W)) {
+        let domain = DomainId::try_new("rd", "universal").unwrap();
+        let w = W {
+            bi: party(),
+            a: party(),
+            b: party(),
+            c: party(),
+            ghost: party(),
+            rd: AssetDefinitionId::new(domain.clone(), name("rd")),
+            dfabi: AssetDefinitionId::new(domain.clone(), name("dfabi")),
+            plain: AssetDefinitionId::new(domain.clone(), name("plain")),
+        };
+        let def = |id: &AssetDefinitionId| {
+            AssetDefinition::numeric(id.clone()).with_name(id.name().to_string()).build(&w.bi.id)
+        };
+        let world = World::with_assets(
+            [Domain::new(domain).build(&w.bi.id)],
+            [&w.bi, &w.a, &w.b, &w.c].map(|p| Account::new(p.id.clone()).build(&p.id)),
+            [def(&w.rd), def(&w.dfabi), def(&w.plain)],
+            [],
+            [],
+        );
+        let state = State::new(world, Kura::blank_kura_for_testing(), LiveQueryStore::start_test());
+        state
+            .block(BlockHeader::new(nonzero!(1_u64), None, None, None, 0, 0))
+            .commit()
+            .expect("bootstrap block");
+        let mut block = state.block(BlockHeader::new(nonzero!(2_u64), None, None, None, 0, 0));
+        {
+            let mut stx = block.transaction();
+            let mut run = |isi: InstructionBox| {
+                Executor::Initial
+                    .execute_instruction(&mut stx, &w.bi.id, isi)
+                    .unwrap_or_else(|e| panic!("setup failed: {e:?}"));
+            };
+            for asset in [&w.rd, &w.dfabi] {
+                let set = |k: &str, v: Json| {
+                    SetKeyValue::asset_definition(asset.clone(), name(k), v).into()
+                };
+                run(set(rd_disclosure::KEY_DISCLOSURE, Json::new("required")));
+                run(set(rd_disclosure::KEY_AUDITOR, Json::new(w.bi.id.to_string())));
+            }
+            run(SetKeyValue::account(
+                w.bi.id.clone(),
+                name(rd_disclosure::KEY_AUDIT_KEYS),
+                Json::from_string_unchecked(KEYS.to_owned()),
+            )
+            .into());
+            for asset in [&w.rd, &w.dfabi, &w.plain] {
+                run(RegisterZkAsset::new(asset.clone(), ZkAssetMode::Hybrid, true, true, None, None, None)
+                    .into());
+            }
+            drop(run);
+            stx.apply();
+        }
+        f(&mut block, &w);
+    }
+
+    fn envelope(asset: &AssetDefinitionId, nf: &[[u8; 32]], outs: &[[u8; 32]]) -> Vec<u8> {
+        let (ct_bi, ct_rc) = ((0..40u8).collect::<Vec<_>>(), vec![0xAA; 20]);
+        let a = asset.to_string();
+        let b = binding(&a, nf, outs, 0, 1, &ct_bi, &ct_rc).unwrap();
+        let mut v = b"RDE1".to_vec();
+        v.extend(1u32.to_be_bytes());
+        v.extend(u16::try_from(a.len()).unwrap().to_be_bytes());
+        v.extend(a.as_bytes());
+        for ct in [&ct_bi, &ct_rc] {
+            v.extend([1u8; 32]);
+            v.extend([2u8; 24]);
+            v.extend(u32::try_from(ct.len()).unwrap().to_be_bytes());
+            v.extend(ct);
+        }
+        v.extend(b);
+        v
+    }
+
+    /// `debug/ok` accepts any proof bytes, `debug/reject` refuses them: the stock proof check is reached.
+    fn leg_with(
+        asset: &AssetDefinitionId,
+        backend: &str,
+        nf: [u8; 32],
+        out: [u8; 32],
+        aux: Option<Vec<u8>>,
+    ) -> ZkTransfer {
+        let mut env = OpenVerifyEnvelope::new(BackendTag::Halo2IpaPasta, "c", [0; 32], vec![], vec![]);
+        env.aux = aux.unwrap_or_default();
+        let bytes = norito::to_bytes(&env).expect("encode envelope");
+        ZkTransfer::new(
+            asset.clone(),
+            vec![nf],
+            vec![out],
+            ProofAttachment::new_inline(
+                backend.into(),
+                ProofBox::new(backend.into(), bytes),
+                VerifyingKeyBox::new(backend.into(), vec![1]),
+            ),
+            None,
+        )
+    }
+
+    /// A leg that passes P2 and the proof check.
+    fn good_leg(asset: &AssetDefinitionId, n: u8) -> ZkTransfer {
+        leg_with(asset, "debug/ok", [n; 32], [n + 1; 32], Some(envelope(asset, &[[n; 32]], &[[n + 1; 32]])))
+    }
+
+    fn chain(stx: &StateTransaction<'_, '_>) -> String {
+        stx.chain_id().as_str().to_owned()
+    }
+
+    fn sign(p: &P, digest: &[u8; 32]) -> Signature {
+        Signature::new(p.kp.private_key(), digest)
+    }
+
+    fn intents(chain: &str, id: &[u8; 32], expiry: u64, d: &ZkTransfer, p: &ZkTransfer, who: [&P; 2]) -> [DvpIntent; 2] {
+        let digest = settlement_digest(chain, id, expiry, d, p).unwrap();
+        who.map(|s| DvpIntent { signer: s.id.clone(), signature: sign(s, &digest) })
+    }
+
+    fn interbank(chain: &str, id: [u8; 32], expiry: u64, d: ZkTransfer, p: ZkTransfer, who: [&P; 2]) -> ConfidentialDvp {
+        let it = intents(chain, &id, expiry, &d, &p, who);
+        ConfidentialDvp::new(id, d, p, expiry, it, DvpKind::Interbank, None)
+    }
+
+    fn award(chain: &str, signer: &P, id: [u8; 32], winner: &P, instrument: &AssetDefinitionId, expiry: u64) -> SignedAward {
+        let mut a = SignedAward {
+            award_id: id,
+            winner: winner.id.clone(),
+            instrument: instrument.clone(),
+            quantity: 10,
+            consideration: 9_900,
+            expiry_height: expiry,
+            bi_signature: Signature::from_bytes(&[]),
+        };
+        a.bi_signature = sign(signer, &award_digest(chain, &a).unwrap());
+        a
+    }
+
+    fn award_trade(chain: &str, id: [u8; 32], d: ZkTransfer, p: ZkTransfer, who: [&P; 2], aw: SignedAward) -> ConfidentialDvp {
+        let it = intents(chain, &id, 100, &d, &p, who);
+        ConfidentialDvp::new(id, d, p, 100, it, DvpKind::Award, Some(aw))
+    }
+
+    fn exec(stx: &mut StateTransaction<'_, '_>, who: &P, dvp: ConfidentialDvp) -> String {
+        match Executor::Initial.execute_instruction(stx, &who.id, InstructionBox::from(dvp)) {
+            Ok(()) => "ok".to_owned(),
+            Err(e) => format!("{e:?}"),
+        }
+    }
+
+    fn spent(stx: &StateTransaction<'_, '_>, asset: &AssetDefinitionId, nf: u8) -> bool {
+        stx.world.zk_assets.get(asset).is_some_and(|s| s.nullifiers.contains(&[nf; 32]))
+    }
+
+    fn used(stx: &StateTransaction<'_, '_>, id: &[u8; 32]) -> bool {
+        stx.world.rd_dvp_used.get(&trade_key(id)).is_some()
+    }
+
+    #[track_caller]
+    fn has(res: &str, needle: &str) {
+        assert!(res.contains(needle), "expected `{needle}` in: {res}");
+    }
+
+    const T1: [u8; 32] = [0xA1; 32];
+    const T2: [u8; 32] = [0xA2; 32];
+
+    fn asset_id(domain: &str, n: &str) -> AssetDefinitionId {
+        AssetDefinitionId::new(DomainId::try_new(domain, "universal").unwrap(), name(n))
+    }
+
+    /// The digest equals a hand-built preimage of the documented encoding and binds every field.
+    #[test]
+    fn rd_dvp_digest_matches_documented_encoding_and_binds_every_field() {
+        let (da, pa) = (asset_id("rd", "dfabi"), asset_id("rd", "rd"));
+        let d = leg_with(&da, "debug/ok", [1; 32], [2; 32], None);
+        let p = leg_with(&pa, "debug/ok", [3; 32], [4; 32], None);
+        let mut pre = b"rd.iroha2.dvp.v1".to_vec();
+        pre.extend([9u8; 32]);
+        pre.extend(1u16.to_be_bytes());
+        pre.extend(b"c");
+        pre.extend(7u64.to_be_bytes());
+        for (asset, nf, out) in [(&da, 1u8, 2u8), (&pa, 3, 4)] {
+            let s = asset.to_string();
+            pre.extend(u16::try_from(s.len()).unwrap().to_be_bytes());
+            pre.extend(s.as_bytes());
+            pre.push(1);
+            pre.extend([nf; 32]);
+            pre.push(1);
+            pre.extend([out; 32]);
+        }
+        let expected: [u8; 32] = Sha256::digest(&pre).into();
+        let base = settlement_digest("c", &[9; 32], 7, &d, &p).unwrap();
+        assert_eq!(base, expected);
+        assert_ne!(base, settlement_digest("c2", &[9; 32], 7, &d, &p).unwrap());
+        assert_ne!(base, settlement_digest("c", &[8; 32], 7, &d, &p).unwrap());
+        assert_ne!(base, settlement_digest("c", &[9; 32], 8, &d, &p).unwrap());
+        assert_ne!(base, settlement_digest("c", &[9; 32], 7, &p, &d).unwrap());
+    }
+
+    #[test]
+    fn rd_dvp_interbank_happy_path_runs_both_legs_and_burns_the_trade_id() {
+        world(|block, w| {
+            let mut stx = block.transaction();
+            let ch = chain(&stx);
+            let d = good_leg(&w.dfabi, 0x10);
+            let p = good_leg(&w.rd, 0x20);
+            let r = exec(&mut stx, &w.a, interbank(&ch, T1, 100, d, p, [&w.a, &w.b]));
+            assert_eq!(r, "ok");
+            assert!(spent(&stx, &w.dfabi, 0x10) && spent(&stx, &w.rd, 0x20));
+            assert!(used(&stx, &T1));
+            // replay of the same trade id, even with fresh notes, is refused
+            let d = good_leg(&w.dfabi, 0x30);
+            let p = good_leg(&w.rd, 0x40);
+            let r = exec(&mut stx, &w.b, interbank(&ch, T1, 100, d, p, [&w.a, &w.b]));
+            has(&r, "rd-dvp: trade_id already used");
+            assert!(!spent(&stx, &w.dfabi, 0x30) && !spent(&stx, &w.rd, 0x40));
+        });
+    }
+
+    #[test]
+    fn rd_dvp_expired_is_rejected() {
+        world(|block, w| {
+            let mut stx = block.transaction();
+            let ch = chain(&stx);
+            let (d, p) = (good_leg(&w.dfabi, 0x10), good_leg(&w.rd, 0x20));
+            // block height is 2: expiry 2 still fine, 1 is over
+            let r = exec(&mut stx, &w.a, interbank(&ch, T1, 1, d.clone(), p.clone(), [&w.a, &w.b]));
+            has(&r, "rd-dvp: expired");
+            assert!(!spent(&stx, &w.dfabi, 0x10) && !used(&stx, &T1));
+            assert_eq!(exec(&mut stx, &w.a, interbank(&ch, T1, 2, d, p, [&w.a, &w.b])), "ok");
+        });
+    }
+
+    #[test]
+    fn rd_dvp_intent_failures() {
+        world(|block, w| {
+            let mut stx = block.transaction();
+            let ch = chain(&stx);
+            let (d, p) = (good_leg(&w.dfabi, 0x10), good_leg(&w.rd, 0x20));
+            let ok = || interbank(&ch, T1, 100, d.clone(), p.clone(), [&w.a, &w.b]);
+
+            // tuple tampered after signing (payment output swapped)
+            let mut t = ok();
+            let evil = good_leg(&w.rd, 0x50);
+            t = ConfidentialDvp::new(T1, d.clone(), evil, 100, t.intents().clone(), DvpKind::Interbank, None);
+            has(&exec(&mut stx, &w.a, t), "rd-dvp: invalid intent signature of");
+
+            // signature missing (empty) for the second party
+            let mut it = ok().intents().clone();
+            it[1].signature = Signature::from_bytes(&[]);
+            let t = ConfidentialDvp::new(T1, d.clone(), p.clone(), 100, it, DvpKind::Interbank, None);
+            has(&exec(&mut stx, &w.a, t), "rd-dvp: invalid intent signature of");
+
+            // intent of b signed by c's key
+            let digest = settlement_digest(&ch, &T1, 100, &d, &p).unwrap();
+            let mut it = ok().intents().clone();
+            it[1].signature = sign(&w.c, &digest);
+            let t = ConfidentialDvp::new(T1, d.clone(), p.clone(), 100, it, DvpKind::Interbank, None);
+            has(&exec(&mut stx, &w.a, t), "rd-dvp: invalid intent signature of");
+
+            // duplicate signer
+            let r = exec(&mut stx, &w.a, interbank(&ch, T1, 100, d.clone(), p.clone(), [&w.a, &w.a]));
+            has(&r, "rd-dvp: the two intents must come from different signers");
+
+            // submitter is neither signer
+            let r = exec(&mut stx, &w.c, ok());
+            has(&r, "rd-dvp: transaction authority must be one of the two signers");
+
+            // unregistered signer (valid signature)
+            let r = exec(&mut stx, &w.a, interbank(&ch, T1, 100, d.clone(), p.clone(), [&w.a, &w.ghost]));
+            has(&r, "is not a registered account");
+
+            // wrong chain id in the signed tuple
+            let r = exec(&mut stx, &w.a, interbank(&format!("{ch}-other"), T1, 100, d.clone(), p.clone(), [&w.a, &w.b]));
+            has(&r, "rd-dvp: invalid intent signature of");
+
+            // none of the above touched state; the correct one still goes through
+            assert!(!spent(&stx, &w.dfabi, 0x10) && !used(&stx, &T1));
+            assert_eq!(exec(&mut stx, &w.b, ok()), "ok");
+        });
+    }
+
+    #[test]
+    fn rd_dvp_kind_and_award_presence_must_match() {
+        world(|block, w| {
+            let mut stx = block.transaction();
+            let ch = chain(&stx);
+            let (d, p) = (good_leg(&w.dfabi, 0x10), good_leg(&w.rd, 0x20));
+            let it = intents(&ch, &T1, 100, &d, &p, [&w.bi, &w.a]);
+            let aw = award(&ch, &w.bi, [5; 32], &w.a, &w.dfabi, 100);
+            let t = ConfidentialDvp::new(T1, d.clone(), p.clone(), 100, it.clone(), DvpKind::Award, None);
+            has(&exec(&mut stx, &w.a, t), "rd-dvp: an award trade needs a signed award");
+            let t = ConfidentialDvp::new(T1, d, p, 100, it, DvpKind::Interbank, Some(aw));
+            has(&exec(&mut stx, &w.a, t), "rd-dvp: an interbank trade carries no award");
+        });
+    }
+
+    #[test]
+    fn rd_dvp_same_asset_or_unflagged_asset_is_rejected() {
+        world(|block, w| {
+            let mut stx = block.transaction();
+            let ch = chain(&stx);
+            let (d, p) = (good_leg(&w.dfabi, 0x10), good_leg(&w.dfabi, 0x20));
+            let r = exec(&mut stx, &w.a, interbank(&ch, T1, 100, d, p, [&w.a, &w.b]));
+            has(&r, "rd-dvp: delivery and payment must be different assets");
+            let (d, p) = (good_leg(&w.dfabi, 0x10), good_leg(&w.plain, 0x20));
+            let r = exec(&mut stx, &w.a, interbank(&ch, T1, 100, d, p, [&w.a, &w.b]));
+            has(&r, "rd-dvp: payment asset");
+            has(&r, "does not have rd_disclosure");
+        });
+    }
+
+    #[test]
+    fn rd_dvp_leg_without_envelope_rejects_the_whole_dvp() {
+        world(|block, w| {
+            // Each scenario in its own transaction, dropped without apply() like a rejected transaction.
+            {
+                let mut stx = block.transaction();
+                let ch = chain(&stx);
+                let d = good_leg(&w.dfabi, 0x10);
+                let p = leg_with(&w.rd, "debug/ok", [0x20; 32], [0x21; 32], None); // P2 envelope missing
+                let r = exec(&mut stx, &w.a, interbank(&ch, T1, 100, d, p, [&w.a, &w.b]));
+                has(&r, "rd-dvp: payment leg failed");
+                has(&r, "rd-disclosure: missing envelope");
+            }
+            {
+                let mut stx = block.transaction();
+                let ch = chain(&stx);
+                let d = leg_with(&w.dfabi, "debug/ok", [0x10; 32], [0x11; 32], None);
+                let p = good_leg(&w.rd, 0x20);
+                let r = exec(&mut stx, &w.a, interbank(&ch, T1, 100, d, p, [&w.a, &w.b]));
+                has(&r, "rd-dvp: delivery leg failed");
+                has(&r, "rd-disclosure: missing envelope");
+            }
+            let stx = block.transaction();
+            assert!(!spent(&stx, &w.dfabi, 0x10) && !spent(&stx, &w.rd, 0x20));
+            assert!(!used(&stx, &T1));
+        });
+    }
+
+    #[test]
+    fn rd_dvp_failing_second_leg_rolls_back_the_first_with_the_transaction() {
+        world(|block, w| {
+            {
+                let mut stx = block.transaction();
+                let ch = chain(&stx);
+                let d = good_leg(&w.dfabi, 0x10);
+                // valid envelope, but the proof check refuses: the stock check of leg 2 was reached
+                let aux = envelope(&w.rd, &[[0x20; 32]], &[[0x21; 32]]);
+                let p = leg_with(&w.rd, "debug/reject", [0x20; 32], [0x21; 32], Some(aux));
+                let r = exec(&mut stx, &w.a, interbank(&ch, T1, 100, d, p, [&w.a, &w.b]));
+                has(&r, "rd-dvp: payment leg failed");
+                has(&r, "invalid transfer proof");
+                // Inside the failed transaction leg 1 was already staged: atomicity is the
+                // transaction's (an Err from any instruction discards the staged state).
+                assert!(spent(&stx, &w.dfabi, 0x10));
+            }
+            let stx = block.transaction();
+            assert!(!spent(&stx, &w.dfabi, 0x10), "delivery leg must not survive the rejected DvP");
+            assert!(!used(&stx, &T1));
+        });
+    }
+
+    #[test]
+    fn rd_dvp_award_happy_path_and_single_use() {
+        world(|block, w| {
+            let mut stx = block.transaction();
+            let ch = chain(&stx);
+            let aw = award(&ch, &w.bi, [5; 32], &w.a, &w.dfabi, 100);
+            let t = award_trade(&ch, T1, good_leg(&w.dfabi, 0x10), good_leg(&w.rd, 0x20), [&w.bi, &w.a], aw.clone());
+            assert_eq!(exec(&mut stx, &w.a, t), "ok");
+            assert!(spent(&stx, &w.dfabi, 0x10) && spent(&stx, &w.rd, 0x20));
+            // same award, new trade id and fresh notes
+            let t = award_trade(&ch, T2, good_leg(&w.dfabi, 0x30), good_leg(&w.rd, 0x40), [&w.bi, &w.a], aw);
+            has(&exec(&mut stx, &w.bi, t), "rd-dvp: award_id already used");
+            assert!(!spent(&stx, &w.dfabi, 0x30) && !used(&stx, &T2));
+        });
+    }
+
+    #[test]
+    fn rd_dvp_award_failures() {
+        world(|block, w| {
+            let mut stx = block.transaction();
+            let ch = chain(&stx);
+            let (d, p) = (|| good_leg(&w.dfabi, 0x10), || good_leg(&w.rd, 0x20));
+            let mut try_award = |aw: SignedAward, who: [&P; 2], sender: &P| {
+                exec(&mut stx, sender, award_trade(&ch, T1, d(), p(), who, aw))
+            };
+            // signed by someone other than the owner of domain rd
+            let r = try_award(award(&ch, &w.a, [5; 32], &w.a, &w.dfabi, 100), [&w.bi, &w.a], &w.a);
+            has(&r, "rd-dvp: invalid award signature of");
+            // award expired (height 2)
+            let r = try_award(award(&ch, &w.bi, [5; 32], &w.a, &w.dfabi, 1), [&w.bi, &w.a], &w.a);
+            has(&r, "rd-dvp: award expired");
+            // winner is not one of the signers
+            let r = try_award(award(&ch, &w.bi, [5; 32], &w.b, &w.dfabi, 100), [&w.bi, &w.a], &w.a);
+            has(&r, "rd-dvp: award winner is not one of the two signers");
+            // the other signer is not bi
+            let r = try_award(award(&ch, &w.bi, [5; 32], &w.a, &w.dfabi, 100), [&w.a, &w.b], &w.a);
+            has(&r, "rd-dvp: an award trade must be signed by the owner of domain `rd`");
+            // award for another instrument
+            let r = try_award(award(&ch, &w.bi, [5; 32], &w.a, &w.rd, 100), [&w.bi, &w.a], &w.a);
+            has(&r, "rd-dvp: award instrument is not the delivery asset");
+            // award fields changed after signing
+            let mut tampered = award(&ch, &w.bi, [5; 32], &w.a, &w.dfabi, 100);
+            tampered.quantity += 1;
+            let r = try_award(tampered, [&w.bi, &w.a], &w.a);
+            has(&r, "rd-dvp: invalid award signature of");
+            drop(try_award);
+            assert!(!spent(&stx, &w.dfabi, 0x10) && !used(&stx, &T1));
+        });
+    }
+
+    #[test]
+    fn rd_dvp_plain_zk_transfer_of_dfabi_stays_allowed() {
+        world(|block, w| {
+            let mut stx = block.transaction();
+            let leg = good_leg(&w.dfabi, 0x10);
+            // P1 has no rule against it...
+            crate::rd_p1::check(&stx, &w.a.id, &InstructionBox::from(leg.clone())).expect("P1 allows UC-05");
+            // ...and it runs through the Initial executor (P2 envelope + proof check) on its own.
+            let r = match Executor::Initial.execute_instruction(&mut stx, &w.a.id, InstructionBox::from(leg)) {
+                Ok(()) => "ok".to_owned(),
+                Err(e) => format!("{e:?}"),
+            };
+            assert_eq!(r, "ok");
+            assert!(spent(&stx, &w.dfabi, 0x10));
+        });
+    }
+}
