+/// Kind of a [`ConfidentialDvp`].
+#[derive(
+    Debug,
+    Clone,
+    Copy,
+    PartialEq,
+    Eq,
+    PartialOrd,
+    Ord,
+    norito::codec::Decode,
+    norito::codec::Encode,
+    iroha_schema::IntoSchema,
+)]
+pub enum DvpKind {
+    /// UC-03: BI awards a DFABI instrument to the winning bank; needs a [`SignedAward`].
+    Award,
+    /// UC-06: interbank DvP; no award.
+    Interbank,
+}
+
+/// One party's consent to a settlement tuple (RD fork patch P3).
+///
+/// `signature` is the signer's account-key signature over the 32-byte settlement digest
+/// (encoding documented on `iroha_core::rd_dvp::settlement_digest`).
+#[derive(
+    Debug,
+    Clone,
+    PartialEq,
+    Eq,
+    PartialOrd,
+    Ord,
+    norito::codec::Decode,
+    norito::codec::Encode,
+    iroha_schema::IntoSchema,
+)]
+pub struct DvpIntent {
+    /// Signing account (a single-key account).
+    pub signer: AccountId,
+    /// Signature over the settlement digest.
+    pub signature: iroha_crypto::Signature,
+}
+
+/// Award record of UC-03, signed by the owner of domain `rd` (encoding on
+/// `iroha_core::rd_dvp::award_digest`).
+#[derive(
+    Debug,
+    Clone,
+    PartialEq,
+    Eq,
+    PartialOrd,
+    Ord,
+    norito::codec::Decode,
+    norito::codec::Encode,
+    iroha_schema::IntoSchema,
+)]
+pub struct SignedAward {
+    /// Single-use award identifier.
+    pub award_id: [u8; 32],
+    /// Winning bank; must be one of the two trade signers.
+    pub winner: AccountId,
+    /// Awarded instrument; must be the delivery asset.
+    pub instrument: AssetDefinitionId,
+    /// Awarded quantity (not checkable against the hidden leg amounts).
+    pub quantity: u128,
+    /// Consideration in RD (not checkable against the hidden leg amounts).
+    pub consideration: u128,
+    /// Last block height at which the award is valid.
+    pub expiry_height: u64,
+    /// Signature of the owner of domain `rd` over the award digest.
+    pub bi_signature: iroha_crypto::Signature,
+}
+
+isi! {
+    /// Atomic confidential DvP: a DFABI `ZkTransfer` leg and an RD `ZkTransfer` leg executed together
+    /// or not at all, bound by two signed intents over one tuple (RD fork patch P3).
+    ///
+    /// Checked and executed by `iroha_core::rd_dvp`. All errors start with `rd-dvp:`.
+    pub struct ConfidentialDvp {
+        /// Single-use trade identifier.
+        pub trade_id: [u8; 32],
+        /// DFABI leg (delivery).
+        pub delivery: ZkTransfer,
+        /// RD leg (payment).
+        pub payment: ZkTransfer,
+        /// Last block height at which the trade may settle.
+        pub expiry_height: u64,
+        /// Consent of both parties (different signers; one of them is the tx authority).
+        pub intents: [DvpIntent; 2],
+        /// Award or interbank.
+        pub kind: DvpKind,
+        /// Required for [`DvpKind::Award`], forbidden for [`DvpKind::Interbank`].
+        pub award: Option<SignedAward>,
+    }
+}
+
+impl crate::seal::Instruction for ConfidentialDvp {}
