@@ -0,0 +1,761 @@
+//! RD fork patch P3: `ConfidentialDvp`, atomic confidential delivery-versus-payment (blueprint gate G4B).
+//!
+//! One instruction carries a DFABI leg (`delivery`) and an RD leg (`payment`), both ordinary
+//! `ZkTransfer`s, plus two signed intents over one immutable settlement tuple. It runs both legs
+//! through the existing `Execute for ZkTransfer` (so P2's envelope check and every v2 proof check
+//! apply to each leg) or neither: any error aborts the transaction, which is discarded unapplied
+//! (`tx.rs::validate_transaction` calls `state_transaction.apply()` only on `Ok`; the instruction
+//! loop is `executor.rs::execute_transaction`, `for isi in instructions { execute_instruction(..)? }`).
+//! Every error starts with `rd-dvp:`. Spec: `platforms/iroha2/docs/spec-g2-g5.md`; design D2 in
+//! `platforms/iroha2/docs/research/g4-dfabi-dvp.md`.
+//!
+//! # Settlement tuple (what each party signs)
+//! ```text
+//! digest = SHA-256( "rd.iroha2.dvp.v1"                       (16 bytes, ASCII)
+//!                   || trade_id                              (32)
+//!                   || u16be(len chain_id) || chain_id utf8
+//!                   || u64be(expiry_height)
+//!                   || leg(delivery) || leg(payment) )
+//! leg   = u16be(len asset) || asset utf8                     (AssetDefinitionId::to_string())
+//!         || u8(n_in)  || nullifier_0  || ... (32 B each, as submitted)
+//!         || u8(n_out) || commitment_0 || ... (32 B each, as submitted)
+//! ```
+//! Each intent signature is an Iroha `Signature` of the signer's account key over the 32 digest bytes.
+//!
+//! # Award (UC-03)
+//! ```text
+//! award_digest = SHA-256( "rd.iroha2.award.v1" (18 bytes) || u16be(len chain_id) || chain_id utf8
+//!                         || award_id (32) || u16be(len winner) || winner utf8   (AccountId::to_string())
+//!                         || u16be(len instrument) || instrument utf8
+//!                         || u128be(quantity) || u128be(consideration) || u64be(expiry_height) )
+//! ```
+//! signed by the owner of domain `rd`. Quantity and consideration are not checked against the legs
+//! (their amounts are hidden by the ZK proof); they are the signed award record, BI also signs the trade tuple.
+
+use iroha_crypto::Hash;
+use iroha_data_model::{
+    account::AccountId,
+    asset::id::AssetDefinitionId,
+    isi::{
+        error::InstructionExecutionError,
+        zk::{ConfidentialDvp, DvpKind, SignedAward, ZkTransfer},
+    },
+};
+use mv::storage::StorageReadOnly;
+use sha2::{Digest, Sha256};
+
+use crate::{
+    smartcontracts::Execute,
+    state::{StateReadOnly, StateTransaction, WorldReadOnly},
+};
+
+const TAG_TUPLE: &[u8] = b"rd.iroha2.dvp.v1";
+const TAG_AWARD: &[u8] = b"rd.iroha2.award.v1";
+const TAG_TRADE_KEY: &[u8] = b"rd.iroha2.dvp.trade-key.v1";
+const TAG_AWARD_KEY: &[u8] = b"rd.iroha2.dvp.award-key.v1";
+/// Asset definition metadata that P2 keys on; both DvP legs must carry it as `"required"`.
+const KEY_DISCLOSURE: &str = crate::rd_disclosure::KEY_DISCLOSURE;
+/// Domain whose owner signs awards (`bi`).
+const RD_DOMAIN: &str = crate::rd_p1::RD_DOMAIN;
+
+fn rejected(msg: impl core::fmt::Display) -> InstructionExecutionError {
+    InstructionExecutionError::InvariantViolation(format!("rd-dvp: {msg}").into())
+}
+
+fn put_str(h: &mut Sha256, s: &str) -> Result<(), String> {
+    let n = u16::try_from(s.len()).map_err(|_| "string longer than 65535 bytes".to_owned())?;
+    h.update(n.to_be_bytes());
+    h.update(s.as_bytes());
+    Ok(())
+}
+
+fn put_leg(h: &mut Sha256, leg: &ZkTransfer) -> Result<(), String> {
+    put_str(h, &leg.asset().to_string())?;
+    let n_in = u8::try_from(leg.inputs().len()).map_err(|_| "more than 255 nullifiers".to_owned())?;
+    h.update([n_in]);
+    leg.inputs().iter().for_each(|n| h.update(n));
+    let n_out = u8::try_from(leg.outputs().len()).map_err(|_| "more than 255 outputs".to_owned())?;
+    h.update([n_out]);
+    leg.outputs().iter().for_each(|o| h.update(o));
+    Ok(())
+}
+
+/// Digest both parties sign (see the module doc for the exact encoding).
+pub fn settlement_digest(
+    chain_id: &str,
+    trade_id: &[u8; 32],
+    expiry_height: u64,
+    delivery: &ZkTransfer,
+    payment: &ZkTransfer,
+) -> Result<[u8; 32], String> {
+    let mut h = Sha256::new();
+    h.update(TAG_TUPLE);
+    h.update(trade_id);
+    put_str(&mut h, chain_id)?;
+    h.update(expiry_height.to_be_bytes());
+    put_leg(&mut h, delivery)?;
+    put_leg(&mut h, payment)?;
+    Ok(h.finalize().into())
+}
+
+/// Digest the owner of domain `rd` signs for an award (see the module doc).
+pub fn award_digest(chain_id: &str, award: &SignedAward) -> Result<[u8; 32], String> {
+    let mut h = Sha256::new();
+    h.update(TAG_AWARD);
+    put_str(&mut h, chain_id)?;
+    h.update(award.award_id);
+    put_str(&mut h, &award.winner.to_string())?;
+    put_str(&mut h, &award.instrument.to_string())?;
+    h.update(award.quantity.to_be_bytes());
+    h.update(award.consideration.to_be_bytes());
+    h.update(award.expiry_height.to_be_bytes());
+    Ok(h.finalize().into())
+}
+
+/// Key under which a used trade id is stored: tagged BLAKE2b-256 (`Hash` forces the last bit to 1).
+fn trade_key(trade_id: &[u8; 32]) -> Hash {
+    Hash::new([TAG_TRADE_KEY, trade_id.as_slice()].concat())
+}
+
+fn award_key(award_id: &[u8; 32]) -> Hash {
+    Hash::new([TAG_AWARD_KEY, award_id.as_slice()].concat())
+}
+
+fn disclosure_required(st: &StateTransaction<'_, '_>, asset: &AssetDefinitionId) -> bool {
+    st.world.asset_definition(asset).is_ok_and(|d| {
+        d.metadata
+            .get(KEY_DISCLOSURE)
+            .is_some_and(|j| crate::rd_disclosure::json_string(j).is_ok_and(|v| v == "required"))
+    })
+}
+
+fn verify_signature(
+    who: &AccountId,
+    signature: &iroha_crypto::Signature,
+    digest: &[u8; 32],
+    what: &str,
+) -> Result<(), InstructionExecutionError> {
+    let key = who
+        .try_signatory()
+        .ok_or_else(|| rejected(format!("{what} {who} is not a single-key account")))?;
+    signature
+        .verify(key, digest)
+        .map_err(|_| rejected(format!("invalid {what} signature of {who}")))
+}
+
+fn check_award(
+    st: &StateTransaction<'_, '_>,
+    dvp: &ConfidentialDvp,
+    award: &SignedAward,
+    signers: [&AccountId; 2],
+    chain_id: &str,
+) -> Result<(), InstructionExecutionError> {
+    let owner = st
+        .world
+        .domains_iter()
+        .find(|d| d.id.name().to_string() == RD_DOMAIN)
+        .map(|d| d.owned_by().clone())
+        .ok_or_else(|| rejected("award needs domain `rd`"))?;
+    if st.block_height() > award.expiry_height {
+        return Err(rejected(format!(
+            "award expired (height {} > expiry_height {})",
+            st.block_height(),
+            award.expiry_height
+        )));
+    }
+    if st.world.rd_dvp_used.get(&award_key(&award.award_id)).is_some() {
+        return Err(rejected("award_id already used"));
+    }
+    if !signers.contains(&&award.winner) {
+        return Err(rejected("award winner is not one of the two signers"));
+    }
+    if !signers.contains(&&owner) {
+        return Err(rejected("an award trade must be signed by the owner of domain `rd`"));
+    }
+    if &award.instrument != dvp.delivery().asset() {
+        return Err(rejected("award instrument is not the delivery asset"));
+    }
+    let digest = award_digest(chain_id, award).map_err(rejected)?;
+    verify_signature(&owner, &award.bi_signature, &digest, "award")
+}
+
+fn check(
+    st: &StateTransaction<'_, '_>,
+    authority: &AccountId,
+    dvp: &ConfidentialDvp,
+) -> Result<(), InstructionExecutionError> {
+    let chain_id = st.chain_id().as_str().to_owned();
+    if st.block_height() > *dvp.expiry_height() {
+        return Err(rejected(format!(
+            "expired (height {} > expiry_height {})",
+            st.block_height(),
+            dvp.expiry_height()
+        )));
+    }
+    if st.world.rd_dvp_used.get(&trade_key(dvp.trade_id())).is_some() {
+        return Err(rejected("trade_id already used"));
+    }
+    let (delivery, payment) = (dvp.delivery().asset(), dvp.payment().asset());
+    if delivery == payment {
+        return Err(rejected("delivery and payment must be different assets"));
+    }
+    for (name, asset) in [("delivery", delivery), ("payment", payment)] {
+        if !disclosure_required(st, asset) {
+            return Err(rejected(format!(
+                "{name} asset {asset} does not have {KEY_DISCLOSURE} = \"required\""
+            )));
+        }
+    }
+
+    let [i0, i1] = dvp.intents();
+    let signers = [&i0.signer, &i1.signer];
+    if signers[0] == signers[1] {
+        return Err(rejected("the two intents must come from different signers"));
+    }
+    if !signers.contains(&authority) {
+        return Err(rejected("transaction authority must be one of the two signers"));
+    }
+    let digest = settlement_digest(
+        &chain_id,
+        dvp.trade_id(),
+        *dvp.expiry_height(),
+        dvp.delivery(),
+        dvp.payment(),
+    )
+    .map_err(rejected)?;
+    for intent in [i0, i1] {
+        if st.world.account(&intent.signer).is_err() {
+            return Err(rejected(format!("signer {} is not a registered account", intent.signer)));
+        }
+        verify_signature(&intent.signer, &intent.signature, &digest, "intent")?;
+    }
+
+    match (dvp.kind(), dvp.award()) {
+        (DvpKind::Interbank, None) => Ok(()),
+        (DvpKind::Interbank, Some(_)) => Err(rejected("an interbank trade carries no award")),
+        (DvpKind::Award, None) => Err(rejected("an award trade needs a signed award")),
+        (DvpKind::Award, Some(award)) => check_award(st, dvp, award, signers, &chain_id),
+    }
+}
+
+impl Execute for ConfidentialDvp {
+    fn execute(
+        self,
+        authority: &AccountId,
+        st: &mut StateTransaction<'_, '_>,
+    ) -> Result<(), InstructionExecutionError> {
+        check(st, authority, &self)?;
+
+        st.world.rd_dvp_used.insert(trade_key(self.trade_id()), ());
+        if let Some(award) = self.award() {
+            st.world.rd_dvp_used.insert(award_key(&award.award_id), ());
+        }
+
+        // Both legs through the stock path; a failure in either rejects the instruction and with it
+        // the transaction, so nothing of the other leg (or of the used-id markers) is applied.
+        for (name, leg) in [("delivery", self.delivery()), ("payment", self.payment())] {
+            leg.clone()
+                .execute(authority, st)
+                .map_err(|e| rejected(format!("{name} leg failed: {e}")))?;
+        }
+
+        iroha_logger::info!(
+            trade_id = %hex::encode(self.trade_id()),
+            delivery_asset = %self.delivery().asset(),
+            delivery_outputs = ?self.delivery().outputs().iter().map(hex::encode).collect::<Vec<_>>(),
+            payment_asset = %self.payment().asset(),
+            payment_outputs = ?self.payment().outputs().iter().map(hex::encode).collect::<Vec<_>>(),
+            "rd-dvp settled"
+        );
+        Ok(())
+    }
+}
+
