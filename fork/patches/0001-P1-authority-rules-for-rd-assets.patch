+        Executor::Initial.execute_instruction(stx, who, isi.into())
+    }
+
+    fn is_p1(res: &Result<(), ValidationFail>) -> bool {
+        matches!(res, Err(ValidationFail::NotPermitted(m)) if m.starts_with("rd-authority:"))
