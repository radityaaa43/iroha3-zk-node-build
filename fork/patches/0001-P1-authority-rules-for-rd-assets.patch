+mod tests {
+    use iroha_crypto::KeyPair;
+    use iroha_data_model::{
+        Registrable as _,
+        asset::id::AssetId,
+        block::BlockHeader,
+        confidential::{ConfidentialEncryptedPayload, ConfidentialStatus},
+        isi::{
