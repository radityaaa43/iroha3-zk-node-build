+//! RD fork patch P1: authority rules for assets and governance in the `rd` domain.
+//!
+//! Active only when a domain named `rd` exists in the world ("rd mode"), and never in the genesis
+//! block. Called from the `Initial` executor (`executor.rs::execute_initial_instruction`) before the
+//! stock checks, so it can only tighten them. Spec: `platforms/iroha2/docs/spec-g2-g5.md` section 4.
+//! Rules 1-8 are the spec; R9 (grant/revoke, unregister, policy transitions) is added because without
+//! it rules 5 and 7 can be bypassed (the stock executor lets any account grant itself any permission).
+//! Every error starts with `rd-authority:`.
+
+use core::any::type_name;
+
+use iroha_data_model::{
+    ValidationFail,
+    account::{Account, AccountId},
+    asset::{
+        AssetDefinition,
+        id::AssetDefinitionId,
+        value::Asset,
+    },
+    isi::{
+        GrantBox, InstructionBox, RemoveKeyValueBox, RevokeBox, SetKeyValueBox, TransferBox,
+        mint_burn::{BurnBox, MintBox},
+        register::UnregisterBox,
+        zk::{
+            CancelConfidentialPolicyTransition, RegisterZkAsset,
+            ScheduleConfidentialPolicyTransition, Shield,
+        },
+        Burn, Grant, Mint, RemoveKeyValue, Revoke, SetKeyValue, SetParameter, Transfer, Unregister,
+        Upgrade,
+    },
+    permission::Permission,
+    prelude::{Domain, DomainId},
+    role::{Role, RoleId},
+};
+use iroha_primitives::numeric::Numeric;
+use mv::storage::StorageReadOnly;
+use norito::codec::Decode;
+
+use crate::state::{StateTransaction, WorldReadOnly};
+
+/// Domain name that switches the rules on.
+pub const RD_DOMAIN: &str = "rd";
+/// Metadata key on an asset definition: JSON array of account ids (`AccountId::to_string()`).
+pub const KEY_ELIGIBLE: &str = "rd_eligible";
+
+fn denied(msg: impl core::fmt::Display) -> ValidationFail {
+    ValidationFail::NotPermitted(format!("rd-authority: {msg}"))
+}
+
+fn is_rd_domain(id: &DomainId) -> bool {
+    id.name().to_string() == RD_DOMAIN
+}
+
+fn in_rd(def: &AssetDefinitionId) -> bool {
+    def.try_domain().is_some_and(is_rd_domain)
+}
+
+/// Owner of the `rd` domain, `None` when the chain has no such domain (rules off).
+fn rd_owner(world: &impl WorldReadOnly) -> Option<AccountId> {
+    world
+        .domains_iter()
+        .find(|d| is_rd_domain(&d.id))
+        .map(|d| d.owned_by().clone())
+}
+
+/// Concrete instruction `T`, from a downcast or (as the stock extractors do) a decode of its bytes.
+fn extract<T: 'static + Clone + Decode>(i: &InstructionBox) -> Option<T> {
+    if let Some(v) = i.as_any().downcast_ref::<T>() {
+        return Some(v.clone());
+    }
+    if i.id() != type_name::<T>() {
+        return None;
+    }
+    let bytes = i.dyn_encode();
+    std::panic::catch_unwind(|| {
+        let mut s = &bytes[..];
+        T::decode(&mut s).ok()
+    })
+    .ok()
+    .flatten()
+}
+
+fn is_type<T: 'static>(i: &InstructionBox) -> bool {
+    i.as_any().is::<T>() || i.id() == type_name::<T>()
+}
+
+fn mint_asset(i: &InstructionBox) -> Option<Mint<Numeric, Asset>> {
+    match i.as_any().downcast_ref::<MintBox>() {
+        Some(MintBox::Asset(m)) => Some(m.clone()),
+        Some(_) => None,
+        None => extract(i),
+    }
+}
+
+fn burn_asset(i: &InstructionBox) -> Option<Burn<Numeric, Asset>> {
+    match i.as_any().downcast_ref::<BurnBox>() {
+        Some(BurnBox::Asset(b)) => Some(b.clone()),
+        Some(_) => None,
+        None => extract(i),
+    }
+}
+
+fn transfer_asset(i: &InstructionBox) -> Option<Transfer<Asset, Numeric, Account>> {
+    match i.as_any().downcast_ref::<TransferBox>() {
+        Some(TransferBox::Asset(t)) => Some(t.clone()),
+        Some(_) => None,
+        None => extract(i),
+    }
+}
+
+enum KvTarget {
+    AssetDefinition(AssetDefinitionId),
+    Domain(DomainId),
+    Account(AccountId),
+}
+
+/// Target of a `SetKeyValue` / `RemoveKeyValue` on an asset definition, domain or account.
+fn kv_target(i: &InstructionBox) -> Option<KvTarget> {
+    let any = i.as_any();
+    if let Some(set) = any.downcast_ref::<SetKeyValueBox>() {
+        return match set {
+            SetKeyValueBox::AssetDefinition(s) => Some(KvTarget::AssetDefinition(s.object.clone())),
+            SetKeyValueBox::Domain(s) => Some(KvTarget::Domain(s.object.clone())),
+            SetKeyValueBox::Account(s) => Some(KvTarget::Account(s.object.clone())),
+            _ => None,
+        };
+    }
+    if let Some(rm) = any.downcast_ref::<RemoveKeyValueBox>() {
+        return match rm {
+            RemoveKeyValueBox::AssetDefinition(r) => {
+                Some(KvTarget::AssetDefinition(r.object.clone()))
+            }
+            RemoveKeyValueBox::Domain(r) => Some(KvTarget::Domain(r.object.clone())),
+            RemoveKeyValueBox::Account(r) => Some(KvTarget::Account(r.object.clone())),
+            _ => None,
+        };
+    }
+    extract::<SetKeyValue<AssetDefinition>>(i)
+        .map(|s| KvTarget::AssetDefinition(s.object))
+        .or_else(|| extract::<RemoveKeyValue<AssetDefinition>>(i).map(|r| KvTarget::AssetDefinition(r.object)))
+        .or_else(|| extract::<SetKeyValue<Domain>>(i).map(|s| KvTarget::Domain(s.object)))
+        .or_else(|| extract::<RemoveKeyValue<Domain>>(i).map(|r| KvTarget::Domain(r.object)))
+        .or_else(|| extract::<SetKeyValue<Account>>(i).map(|s| KvTarget::Account(s.object)))
+        .or_else(|| extract::<RemoveKeyValue<Account>>(i).map(|r| KvTarget::Account(r.object)))
+}
+
+fn unregister_target(i: &InstructionBox) -> Option<KvTarget> {
+    match i.as_any().downcast_ref::<UnregisterBox>() {
+        Some(UnregisterBox::AssetDefinition(u)) => {
+            Some(KvTarget::AssetDefinition(u.object.clone()))
+        }
+        Some(UnregisterBox::Domain(u)) => Some(KvTarget::Domain(u.object.clone())),
+        Some(_) => None,
+        None => extract::<Unregister<AssetDefinition>>(i)
+            .map(|u| KvTarget::AssetDefinition(u.object))
+            .or_else(|| extract::<Unregister<Domain>>(i).map(|u| KvTarget::Domain(u.object))),
+    }
+}
+
+fn is_grant_or_revoke(i: &InstructionBox) -> bool {
+    i.as_any().is::<GrantBox>()
+        || i.as_any().is::<RevokeBox>()
+        || is_type::<Grant<Permission, Account>>(i)
+        || is_type::<Grant<RoleId, Account>>(i)
+        || is_type::<Grant<Permission, Role>>(i)
+        || is_type::<Revoke<Permission, Account>>(i)
+        || is_type::<Revoke<RoleId, Account>>(i)
+        || is_type::<Revoke<Permission, Role>>(i)
+}
+
+fn def_owner(world: &impl WorldReadOnly, def: &AssetDefinitionId) -> Option<AccountId> {
+    world.asset_definition(def).ok().map(|d| d.owned_by().clone())
+}
+
+/// `authority` must own the asset definition `def` (an unknown definition is left to the stock error).
+fn require_def_owner(
+    world: &impl WorldReadOnly,
+    authority: &AccountId,
+    def: &AssetDefinitionId,
+    what: &str,
+) -> Result<(), ValidationFail> {
+    match def_owner(world, def) {
+        Some(owner) if &owner == authority => Ok(()),
+        Some(_) => Err(denied(format!("{what} of {def} requires the asset definition owner"))),
+        None => Ok(()),
+    }
+}
+
+/// Rule 8: if the definition has `rd_eligible`, `account` must be listed.
+fn require_eligible(
+    world: &impl WorldReadOnly,
+    def: &AssetDefinitionId,
+    account: &AccountId,
+) -> Result<(), ValidationFail> {
+    let Ok(definition) = world.asset_definition(def) else {
+        return Ok(());
+    };
+    let Some(json) = definition.metadata.get(KEY_ELIGIBLE) else {
+        return Ok(());
+    };
+    let list: Vec<String> = json
+        .try_into_any()
+        .map_err(|_| denied(format!("{KEY_ELIGIBLE} of {def} is not a JSON array of strings")))?;
+    if list.iter().any(|a| a == &account.to_string()) {
+        Ok(())
+    } else {
+        Err(denied(format!("{account} is not in {KEY_ELIGIBLE} of {def}")))
+    }
+}
+
+/// Permission held by name (direct or through a role); payload ignored.
+fn has_named_permission(world: &impl WorldReadOnly, who: &AccountId, name: &str) -> bool {
+    if world
+        .account_permissions_iter(who)
+        .is_ok_and(|mut perms| perms.any(|p| p.name() == name))
+    {
+        return true;
+    }
+    world.account_roles_iter(who).any(|role_id| {
+        world
+            .roles()
+            .get(role_id)
+            .is_some_and(|role| role.permissions.iter().any(|p| p.name() == name))
+    })
+}
+
+/// Enforce P1 for one instruction. `Ok(())` when rd mode is off or the instruction is outside P1.
+pub(crate) fn check(
+    st: &StateTransaction<'_, '_>,
+    authority: &AccountId,
+    i: &InstructionBox,
+) -> Result<(), ValidationFail> {
+    let w = &st.world;
+    let Some(rd_owner) = rd_owner(w) else {
+        return Ok(());
+    };
+
+    // Rule 1 (+8): mint = definition owner, destination eligible.
+    if let Some(m) = mint_asset(i) {
+        let def = m.destination.definition();
+        if in_rd(def) {
+            require_def_owner(w, authority, def, "mint")?;
+            require_eligible(w, def, m.destination.account())?;
+        }
+        return Ok(());
+    }
+    // Rule 1: burn = definition owner.
+    if let Some(b) = burn_asset(i) {
+        let def = b.destination.definition();
+        if in_rd(def) {
+            require_def_owner(w, authority, def, "burn")?;
+        }
+        return Ok(());
+    }
+    // Rule 2 (+8): shield = the account that is debited, and it must be eligible.
+    if let Some(s) = extract::<Shield>(i) {
+        if in_rd(&s.asset) {
+            if &s.from != authority {
+                return Err(denied("shield requires the debited account to sign"));
+            }
+            require_eligible(w, &s.asset, &s.from)?;
+        }
+        return Ok(());
+    }
+    // Rule 3 (+8): transparent transfer = source account only (no domain-owner override).
+    if let Some(t) = transfer_asset(i) {
+        let def = t.source.definition();
+        if in_rd(def) {
+            if t.source.account() != authority {
+                return Err(denied("transfer requires the source account to sign"));
+            }
+            require_eligible(w, def, &t.destination)?;
+        }
+        return Ok(());
+    }
+    // Rule 4: RegisterZkAsset = definition owner; a set vk_transfer cannot change or clear.
+    if let Some(r) = extract::<RegisterZkAsset>(i) {
+        if in_rd(&r.asset) {
+            require_def_owner(w, authority, &r.asset, "register zk asset")?;
+            if let Some(locked) = w.zk_assets.get(&r.asset).and_then(|s| s.vk_transfer.clone()) {
+                let same = r.vk_transfer.as_ref().is_some_and(|id| {
+                    id == &locked.id
+                        && w.verifying_keys
+                            .get(id)
+                            .is_some_and(|rec| rec.commitment == locked.commitment)
+                });
+                if !same {
+                    return Err(denied("vk_transfer is bound and cannot be changed or cleared"));
+                }
+            }
+        }
+        return Ok(());
+    }
+    // Rule 5 is enforced by RegisterVerifyingKey / UpdateVerifyingKey themselves
+    // (CanManageVerifyingKeys, world.rs); R9 below stops anyone else from granting it.
+
+    // Rule 6: metadata writes.
+    if let Some(target) = kv_target(i) {
+        match target {
+            KvTarget::AssetDefinition(def) if in_rd(&def) => {
+                require_def_owner(w, authority, &def, "metadata write")?;
+            }
+            KvTarget::Domain(d) if is_rd_domain(&d) => {
+                let owner = w.domain(&d).map(|dom| dom.owned_by().clone()).ok();
+                if owner.is_some_and(|o| &o != authority) {
+                    return Err(denied("rd domain metadata requires the domain owner"));
+                }
+            }
+            // The account itself only; this also covers `rd_*` keys of the rd owner (bi).
+            KvTarget::Account(acc) if &acc != authority => {
+                return Err(denied("account metadata requires the account itself"));
+            }
+            _ => {}
+        }
+        return Ok(());
+    }
+    // Rule 7: SetParameter / Upgrade need a permission that only the rd owner is granted.
+    if is_type::<SetParameter>(i) && !has_named_permission(w, authority, "CanSetParameters") {
+        return Err(denied("SetParameter requires CanSetParameters"));
+    }
+    if is_type::<Upgrade>(i) && !has_named_permission(w, authority, "CanUpgradeExecutor") {
+        return Err(denied("Upgrade requires CanUpgradeExecutor"));
+    }
+    // R9: grants and revokes only by the rd owner, else rules 5 and 7 are bypassable.
+    if is_grant_or_revoke(i) && authority != &rd_owner {
+        return Err(denied("grant/revoke requires the rd domain owner"));
+    }
+    // R9: nobody but the owner unregisters rd things or schedules policy transitions on them.
+    if let Some(target) = unregister_target(i) {
+        match target {
+            KvTarget::AssetDefinition(def) if in_rd(&def) => {
+                require_def_owner(w, authority, &def, "unregister")?;
+            }
+            KvTarget::Domain(d) if is_rd_domain(&d) && authority != &rd_owner => {
+                return Err(denied("unregister of the rd domain requires its owner"));
+            }
+            _ => {}
+        }
+    }
+    let policy_asset = extract::<ScheduleConfidentialPolicyTransition>(i)
+        .map(|s| s.asset)
+        .or_else(|| extract::<CancelConfidentialPolicyTransition>(i).map(|c| c.asset));
+    if let Some(def) = policy_asset {
+        if in_rd(&def) {
+            require_def_owner(w, authority, &def, "policy transition")?;
+        }
+    }
+    Ok(())
+}
+
