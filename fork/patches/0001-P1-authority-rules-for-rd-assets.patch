+            let reg = || RegisterVerifyingKey { id: id.clone(), record: vk_record(1, vec![1, 2, 3]).1 };
+            let res = exec(stx, &ids.a, reg());
+            assert!(res.is_err(), "no permission must fail: {res:?}");
+            // cannot self-grant (R9), only the rd owner grants
+            denied_p1(exec(stx, &ids.a, Grant::account_permission(perm("CanManageVerifyingKeys"), ids.a.clone())));
+            ok(exec(stx, &ids.bi, Grant::account_permission(perm("CanManageVerifyingKeys"), ids.bi.clone())));
+            ok(exec(stx, &ids.bi, reg()));
+            let res = exec(stx, &ids.a, UpdateVerifyingKey { id: id.clone(), record: vk_record(2, vec![1, 2, 3]).1 });
+            assert!(res.is_err(), "update without permission must fail: {res:?}");
+        });
+    }
