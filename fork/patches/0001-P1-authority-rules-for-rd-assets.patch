+
+    fn vk_record(version: u32, bytes: Vec<u8>) -> (VerifyingKeyBox, VerifyingKeyRecord) {
+        let circuit = format!("vk{}", bytes[0]);
+        let vk = VerifyingKeyBox::new("halo2/ipa".into(), bytes.clone());
+        let mut rec = VerifyingKeyRecord::new(
+            version,
+            circuit,
+            BackendTag::Halo2IpaPasta,
+            "pallas",
+            [0x5A; 32],
+            crate::zk::hash_vk(&vk),
+        );
+        rec.vk_len = u32::try_from(bytes.len()).unwrap();
+        rec.key = Some(vk.clone());
+        rec.status = ConfidentialStatus::Active;
+        rec.gas_schedule_id = Some("halo2_default".into());
+        (vk, rec)
+    }
+
+    #[test]
+    fn r4_vk_transfer_cannot_change_or_clear() {
+        run(false, |stx, ids| {
+            Grant::account_permission(perm("CanManageVerifyingKeys"), ids.bi.clone())
+                .execute(&ids.bi, stx)
+                .unwrap();
+            let id_a = VerifyingKeyId::new("halo2/ipa", "vk_a");
+            let id_b = VerifyingKeyId::new("halo2/ipa", "vk_b");
+            for (id, bytes) in [(&id_a, vec![1, 2, 3]), (&id_b, vec![4, 5, 6])] {
+                ok(exec(stx, &ids.bi, RegisterVerifyingKey { id: id.clone(), record: vk_record(1, bytes).1 }));
+            }
+            ok(register_zk(stx, &ids.bi, &ids.rd, Some(id_a.clone())));
+            denied_p1(register_zk(stx, &ids.bi, &ids.rd, None)); // clear
+            denied_p1(register_zk(stx, &ids.bi, &ids.rd, Some(id_b))); // change
+            // same key, same commitment: allowed
+            ok(register_zk(stx, &ids.bi, &ids.rd, Some(id_a.clone())));
+            // same id but the record was updated since binding: rebinding is refused
+            ok(exec(stx, &ids.bi, UpdateVerifyingKey { id: id_a.clone(), record: vk_record(2, vec![1, 9, 9]).1 }));
+            denied_p1(register_zk(stx, &ids.bi, &ids.rd, Some(id_a)));
+        });
+    }
