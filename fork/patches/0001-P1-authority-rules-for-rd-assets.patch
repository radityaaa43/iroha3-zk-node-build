+    /// World with domain `rd` owned by bi (assets `rd`, `dfabi`) and domain `users` (asset `coin`).
+    /// `genesis`: run inside the genesis block instead of block 2.
+    fn run(genesis: bool, f: impl FnOnce(&mut StateTransaction<'_, '_>, &Ids)) {
+        let ids = Ids {
+            bi: acct(),
+            a: acct(),
+            b: acct(),
+            rd: AssetDefinitionId::new(DomainId::try_new("rd", "universal").unwrap(), name("rd")),
+            bond: AssetDefinitionId::new(
+                DomainId::try_new("rd", "universal").unwrap(),
+                name("dfabi"),
+            ),
+            coin: AssetDefinitionId::new(
+                DomainId::try_new("users", "universal").unwrap(),
+                name("coin"),
+            ),
+            mine: AssetDefinitionId::new(
+                DomainId::try_new("rd", "universal").unwrap(),
+                name("mine"),
+            ),
+        };
+        let def = |id: &AssetDefinitionId, owner: &AccountId| {
+            AssetDefinition::numeric(id.clone())
+                .with_name(id.name().to_string())
+                .build(owner)
+        };
+        let world = World::with_assets(
+            [
+                Domain::new(DomainId::try_new("rd", "universal").unwrap()).build(&ids.bi),
+                Domain::new(DomainId::try_new("users", "universal").unwrap()).build(&ids.bi),
+            ],
+            [&ids.bi, &ids.a, &ids.b].map(|id| Account::new(id.clone()).build(id)),
+            [
+                def(&ids.rd, &ids.bi),
+                def(&ids.bond, &ids.bi),
+                def(&ids.coin, &ids.bi),
+                def(&ids.mine, &ids.a),
+            ],
+            [],
+            [],
+        );
+        let state = State::new(world, Kura::blank_kura_for_testing(), LiveQueryStore::start_test());
+        let mut height = nonzero!(1_u64);
+        if !genesis {
+            state
+                .block(BlockHeader::new(height, None, None, None, 0, 0))
+                .commit()
+                .expect("commit bootstrap block");
+            height = nonzero!(2_u64);
+        }
+        let mut block = state.block(BlockHeader::new(height, None, None, None, 0, 0));
+        let mut stx = block.transaction();
+        assert_eq!(genesis, stx._curr_block.is_genesis() && stx.block_hashes.is_empty());
+        f(&mut stx, &ids);
+    }
